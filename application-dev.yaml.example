# ============================================================
# M78 NetDisk 开发环境配置模板
# 复制为 application-dev.yaml 并填入实际值
# ============================================================

spring:
  datasource:
    password: 你的数据库密码
    db-host: 192.168.x.x
    db-port: 3306
  ai:
    openai:
      api-key: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
      # 默认使用 DeepSeek，也可换为其他 OpenAI 兼容 API
      # base-url: https://api.deepseek.com
      # chat.options.model: deepseek-chat
  data:
    redis:
      host: 192.168.x.x
      # port: 6379
  devtools:
    restart:
      enabled: true
      additional-paths: ../netdisk-common/src/main/java,../netdisk-user/src/main/java,../netdisk-file/src/main/java,../netdisk-share/src/main/java,../netdisk-vault/src/main/java,../netdisk-calendar/src/main/java,../netdisk-album/src/main/java,../netdisk-ai/src/main/java
      exclude:
        - "static/**"
        - "public/**"
        - "*.html"
        - "*.json"
        - "*.png"
        - "*.jpg"
        - "*.jpeg"
        - "*.gif"
        - "*.css"
        - "*.ico"
        - "*.ttf"
        - "*.woff"
        - "*.woff2"

netdisk:
  jwt:
    # 至少 256 位，用于 HS256 签名
    secret: 请生成一个至少256位的随机密钥
  storage:
    # 存储后端：oss（阿里云 OSS）或 local（本地磁盘）
    type: oss
    oss:
      endpoint: oss-cn-xxx.aliyuncs.com
      access-key-id: LTAIxxxxxxxxxxxxxxxx
      access-key-secret: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
      bucket-name: your-bucket-name
