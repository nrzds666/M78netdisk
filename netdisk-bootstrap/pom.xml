<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>m78-netdisk</artifactId>
        <groupId>com.m78</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>netdisk-bootstrap</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.m78</groupId>
            <artifactId>netdisk-common</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.m78</groupId>
            <artifactId>netdisk-user</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.m78</groupId>
            <artifactId>netdisk-file</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.m78</groupId>
            <artifactId>netdisk-album</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.m78</groupId>
            <artifactId>netdisk-share</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- mysql-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 【新增】热部署：直接声明在bootstrap模块，不依赖Maven dev profile -->
        <!-- runtime+optional 确保不会打进生产JAR -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.m78</groupId>
            <artifactId>netdisk-vault</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.m78</groupId>
            <artifactId>netdisk-calendar</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.m78</groupId>
            <artifactId>netdisk-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- jodconverter -->
        <dependency>
            <groupId>org.jodconverter</groupId>
            <artifactId>jodconverter-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jodconverter</groupId>
            <artifactId>jodconverter-local</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>m78-netdisk</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <fork>true</fork>
                    <addResources>true</addResources>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>