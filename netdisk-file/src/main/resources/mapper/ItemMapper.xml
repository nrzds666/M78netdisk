<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.m78.netdisk.file.mapper.ItemMapper">

    <resultMap id="BaseResultMap" type="com.m78.netdisk.file.domain.po.Item">
        <id column="id" property="id"/>
        <result column="owner_id" property="ownerId"/>
        <result column="parent_id" property="parentId"/>
        <result column="name" property="name"/>
        <result column="is_directory" property="isDirectory"/>
        <result column="size" property="size"/>
        <result column="mime_type" property="mimeType"/>
        <result column="storage_key" property="storageKey"/>
        <result column="etag" property="etag"/>
        <result column="thumbnail_key" property="thumbnailKey"/>
        <result column="path" property="path"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="deleted_at" property="deletedAt"/>
        <result column="version" property="version"/>
        <result column="is_vaulted" property="isVaulted"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectRootItems" resultMap="BaseResultMap">
        SELECT * FROM items
        WHERE owner_id = #{ownerId} AND parent_id IS NULL AND NOT is_deleted AND NOT is_vaulted
        ORDER BY is_directory DESC, sort_order ASC, name ASC
    </select>

    <select id="selectChildren" resultMap="BaseResultMap">
        SELECT * FROM items
        WHERE owner_id = #{ownerId} AND parent_id = #{parentId} AND NOT is_deleted AND NOT is_vaulted
        ORDER BY is_directory DESC, sort_order ASC, name ASC
    </select>

    <select id="selectFilteredItems" resultMap="BaseResultMap">
        SELECT * FROM items
        WHERE owner_id = #{ownerId} AND NOT is_deleted AND NOT is_vaulted
        <if test="parentId != null">
            AND parent_id = #{parentId}
        </if>
        <if test="parentId == null">
            AND parent_id IS NULL
        </if>
        <if test="query != null and query != ''">
            AND name LIKE CONCAT('%', #{query}, '%')
        </if>
        <if test="mimePrefix != null and mimePrefix != ''">
            AND mime_type LIKE CONCAT(#{mimePrefix}, '%')
        </if>
        <if test="mimeTypes != null and mimeTypes.size() > 0">
            AND mime_type IN
            <foreach item="mt" collection="mimeTypes" open="(" separator="," close=")">
                #{mt}
            </foreach>
        </if>
        <if test="excludePrefix != null and excludePrefix != ''">
            AND (mime_type IS NULL OR mime_type NOT LIKE CONCAT(#{excludePrefix}, '%'))
        </if>
        <if test="dateFrom != null">
            AND updated_at >= #{dateFrom}
        </if>
        <if test="dateTo != null">
            AND updated_at &lt;= #{dateTo}
        </if>
        ORDER BY is_directory DESC, sort_order ASC, name ASC
    </select>

    <select id="selectTrash" resultMap="BaseResultMap">
        SELECT * FROM items
        WHERE owner_id = #{ownerId} AND is_deleted
        ORDER BY deleted_at DESC
    </select>

</mapper>